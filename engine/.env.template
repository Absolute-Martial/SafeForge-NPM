# Engine — Environment Template
# Copy to .env and fill in real values.

# API server
SAFEFORGE_NPM_API_HOST=0.0.0.0
SAFEFORGE_NPM_API_PORT=8000

# LLM backend: "anthropic" or "openai_compatible"
SAFEFORGE_NPM_LLM_BACKEND=openai_compatible
SAFEFORGE_NPM_LLM_BASE_URL=https://api.featherless.ai/v1
SAFEFORGE_NPM_LLM_API_KEY=

# IPFS publish (Pinata)
PINATA_JWT=
PINATA_GATEWAY_HOST=gateway.pinata.cloud

# ENS publish (Sepolia)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
SAFEFORGE_NPM_BASE_DOMAIN=safeforge-npm.eth

# Per-phase models (Featherless AI — OpenAI-compatible)
SAFEFORGE_NPM_TRIAGE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
SAFEFORGE_NPM_INVESTIGATION_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
SAFEFORGE_NPM_TEST_GEN_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Shared runtime root (important for Docker Compose / sibling sandboxes)
SAFEFORGE_NPM_RUNTIME_ROOT=/runtime
SAFEFORGE_NPM_RUNTIME_HOST_ROOT=

# Optional advisory enrichment
SAFEFORGE_NPM_GITHUB_TOKEN=
SAFEFORGE_NPM_NVD_API_KEY=
